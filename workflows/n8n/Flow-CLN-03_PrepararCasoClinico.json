    {
      "parameters": {
        "jsCode": "const input = $('Normalize Clinical Case Trigger').first().json;\nconst alert = $('Get Source Alert').first()?.json ?? {};\nconst history = $('Get Patient History').first()?.json ?? null;\nconst readings = $('Get Recent Readings').all().map((item) => item.json).filter((item) => item?.id);\nconst dailyContext = $('Get Recent Daily Context').all().map((item) => item.json).filter((item) => item?.id);\nconst adherence = $('Get Adherence Summaries').all().map((item) => item.json).filter((item) => item?.id);\nconst professionalLink = $('Get Active Professional Link').first()?.json ?? {};\nconst missingData = [];\nif (!history?.completed_at) missingData.push('patient_history.completed_at');\nif (!alert.source_reading_id) missingData.push('alert.source_reading_id');\nif (readings.length === 0) missingData.push('recent_readings');\nif (dailyContext.length === 0) missingData.push('recent_daily_context');\nif (adherence.length === 0) missingData.push('adherence_summary');\nconst assignedProfessionalId = professionalLink.professional_id ?? null;\nconst status = !assignedProfessionalId ? 'waiting_professional' : (missingData.length ? 'partial' : 'prepared');\nreturn [{ json: { ...input, assigned_professional_id: assignedProfessionalId, context_version: '1.0.0', context_status: status, missing_data: missingData, snapshot: { alert, triggering_reading: readings.find((reading) => reading.id === alert.source_reading_id) ?? null, history: history ? { revision: history.revision, completed_at: history.completed_at, updated_at: history.updated_at, data: history.data } : null, recent_readings: readings, recent_daily_context: dailyContext, adherence_summaries: adherence } } }];"
      },
