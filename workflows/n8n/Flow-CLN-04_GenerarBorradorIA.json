      "position": [-192, 96],
      "id": "cln04-sources",
      "name": "Get Approved Clinical Sources",
      "alwaysOutputData": true,
      "credentials": { "supabaseApi": { "id": "15MOY6FyWlWDp9v7", "name": "Supabase account" } }
    },
    {
      "parameters": {
        "jsCode": "const context = $('Get Clinical Case Context').first().json;\nconst sources = $('Get Approved Clinical Sources').all().map((item) => item.json).filter((source) => source?.source_key);\nconst sourceRegistry = sources.map((source) => ({ source_key: source.source_key, title: source.title, organization: source.organization, version_label: source.version_label, url: source.url, evidence_scope: source.evidence_scope }));\nconst snapshot = context.snapshot && typeof context.snapshot === 'object' ? context.snapshot : {};\nconst systemPrompt = `Eres un asistente de apoyo para profesionales que revisan alertas de seguimiento de glucosa. Genera un BORRADOR para que un profesional lo revise y edite.\n\nReglas obligatorias:\n- No diagnostiques, no prescribas, no cambies medicamentos, no indiques dosis y no envíes mensajes al paciente.\n- Describe hechos del contexto y separa observaciones de preguntas pendientes.\n- Si faltan datos, dilo de forma explícita y evita completar con suposiciones.\n- Las acciones sugeridas deben ser pasos de revisión profesional, como verificar síntomas, confirmar contexto de la lectura o consultar la historia, nunca decisiones terapéuticas automáticas.\n- Usa únicamente las fuentes del registro que sean pertinentes y cita sus source_key; no inventes fuentes.\n- La salida debe estar en español y respetar exactamente el esquema JSON solicitado.`;\nconst schema = { type: 'object', additionalProperties: false, properties: { draft_text: { type: 'string' }, summary: { type: 'string' }, observations: { type: 'array', items: { type: 'string' } }, pending_questions: { type: 'array', items: { type: 'string' } }, suggested_review_actions: { type: 'array', items: { type: 'string' } }, safety_flags: { type: 'array', items: { type: 'string' } }, source_citations: { type: 'array', items: { type: 'string' } } }, required: ['draft_text', 'summary', 'observations', 'pending_questions', 'suggested_review_actions', 'safety_flags', 'source_citations'] };\nconst request_body = { model: 'gpt-4o-mini', temperature: 0.2, input: [{ role: 'system', content: [{ type: 'input_text', text: systemPrompt }] }, { role: 'user', content: [{ type: 'input_text', text: JSON.stringify({ clinical_task_id: context.clinical_task_id, patient_id: context.patient_id, context_status: context.status, missing_data: context.missing_data, snapshot, source_registry }) }] }], text: { format: { type: 'json_schema', name: 'clinical_support_draft', strict: true, schema } } };\nreturn [{ json: { ...$('Decide Whether To Generate').first().json, prompt_version: 'clinical-support-v1', model: 'gpt-4o-mini', source_registry: sourceRegistry, request_body } }];"
      },
