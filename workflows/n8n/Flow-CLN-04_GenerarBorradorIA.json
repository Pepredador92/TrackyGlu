      "parameters": {
        "jsCode": "const trigger = $('Normalize AI Draft Trigger').first().json;\nconst context = $('Get Clinical Case Context').first().json;\nconst existing = $('Get Existing AI Draft').first()?.json ?? {};\nconst reusable = ['generated', 'edited', 'approved'].includes(existing.status);\nreturn [{ json: { ...trigger, context_id: context.id, clinical_task_id: context.clinical_task_id, patient_id: context.patient_id, existing_draft_id: existing.id || null, existing_draft_status: existing.status || null, should_generate: !reusable } }];"
      },
