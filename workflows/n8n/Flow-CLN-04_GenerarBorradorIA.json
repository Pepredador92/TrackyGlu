      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [256, 96],
      "id": "cln04-openai",
      "name": "OpenAI Responses - Structured Output",
      "credentials": { "httpHeaderAuth": { "id": "OPENAI_N8N_CREDENTIAL_ID", "name": "OpenAI API Header" } }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first()?.json ?? {};\nconst statusCode = Number(response.statusCode ?? response.status ?? 200);\nconst body = response.body && typeof response.body === 'object' ? response.body : response;\nconst outputText = body.output_text || body.output?.flatMap((item) => item.content || []).find((content) => content.type === 'output_text')?.text || null;\nconst base = $('Build Grounded Clinical Prompt').first().json;\nif (statusCode >= 400 || !outputText) return [{ json: { ...base, ai_ok: false, error_message: body.error?.message || `OpenAI respondió ${statusCode} sin contenido estructurado.` } }];\nlet parsed;\ntry { parsed = JSON.parse(outputText); } catch { return [{ json: { ...base, ai_ok: false, error_message: 'La respuesta de OpenAI no se pudo interpretar como JSON.' } }]; }\nconst arrays = ['observations', 'pending_questions', 'suggested_review_actions', 'safety_flags', 'source_citations'];\nif (typeof parsed.draft_text !== 'string' || !parsed.draft_text.trim() || typeof parsed.summary !== 'string' || arrays.some((key) => !Array.isArray(parsed[key]))) return [{ json: { ...base, ai_ok: false, error_message: 'La salida estructurada no cumple el contrato del borrador clínico.' } }];\nconst allowed = new Set((base.source_registry || []).map((source) => source.source_key));\nconst sourceKeys = parsed.source_citations.filter((key) => typeof key === 'string' && allowed.has(key));\nreturn [{ json: { ...base, ai_ok: true, draft_text: parsed.draft_text.trim(), structured_output: parsed, source_keys: sourceKeys, generated_at: new Date().toISOString() } }];"
      },
